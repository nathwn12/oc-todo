{
  "name": "oc-todo",
  "version": "0.1.2",
  "description": "Per-session todo lists for OpenCode V2 - a `todo` tool with real plugin storage and a read-only sidebar checklist, including V1 todowrite parity.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "tui",
    "todo",
    "todowrite",
    "tasks",
    "checklist"
  ],
  "license": "MIT",
  "author": "nathwn12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathwn12/oc-todo.git"
  },
  "homepage": "https://github.com/nathwn12/oc-todo#readme",
  "bugs": {
    "url": "https://github.com/nathwn12/oc-todo/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    },
    "./tui": {
      "types": "./tui.tsx",
      "import": "./tui.tsx"
    },
    "./contract": {
      "types": "./contract.ts",
      "import": "./contract.ts"
    }
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "contract.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun test",
    "check": "bun test",
    "prepublishOnly": "bun run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  }
}
